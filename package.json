{
  "name": "dsh-review-checkout",
  "version": "0.9.0",
  "description": "File-change review for DeepSeek Harness sessions: per-turn change cards styled like the official deliverables card with one-click per-turn revert, a turn-scoped review tab (draggable split diff, syntax highlighting, real line numbers), and a three-step open chain (chosen editor at the line -> OS default app -> built-in preview).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "diff",
    "review"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "sync": "node scripts/sync-profile.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binaryinject/dsh-review-checkout.git"
  },
  "homepage": "https://github.com/Binaryinject/dsh-review-checkout#readme",
  "bugs": {
    "url": "https://github.com/Binaryinject/dsh-review-checkout/issues"
  },
  "author": "dsh-review-checkout contributors <dsh-review-checkout@users.noreply.github.com>",
  "engines": {
    "node": ">=18"
  }
}
